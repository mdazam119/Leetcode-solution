/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    int ans = 0;
    
    class Pair{
        int sum;
        int count;

        Pair(int sum , int count){
            this.sum = sum;
            this.count = count;

        }
    }
    public int averageOfSubtree(TreeNode root) {
        
        

        Postorder(root );
        return ans;
        
    }

    Pair Postorder(TreeNode root  ){

        // if rrot is null then it return sum = 0 , count = 0
        if(root == null){
            return new Pair(0 , 0);
        }
      // left se sum and count chahiye
      Pair left = Postorder(root.left );
      //right se sum and count chahiye
      Pair right = Postorder(root.right );

      // total sum for current subtree
      int sum = left.sum + right.sum + root.val;
      // total count for current subtree

      int count = left.count + right.count + 1;

      // find avg 
      int avg = sum / count;

      // comapre avg ana rrot.val

      if(avg == root.val){
        ans++;
      }

      // return current subtree ka sum and count 
      return new Pair(sum , count);

    }
}
